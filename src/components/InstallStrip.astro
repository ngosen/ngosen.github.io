---
import { INSTALL_COMMAND } from '../data/site';

interface Props {
  lang?: 'vi' | 'en';
  // Inside a page sheet the strip is a block of the text column, not a full-width band.
  inset?: boolean;
}

const { lang = 'vi', inset = false } = Astro.props;
const text =
  lang === 'en'
    ? { label: 'Install command', copy: 'Copy', copied: 'Copied', manual: 'Selected. Press Ctrl+C.' }
    : { label: 'Lệnh cài', copy: 'Chép lệnh', copied: 'Đã chép', manual: 'Đã bôi đen. Bấm Ctrl+C.' };
---

<div class:list={['strip', { inset }]} data-install data-copied={text.copied} data-manual={text.manual}>
  <div class="inner">
    <code class="command" aria-label={text.label} tabindex="0">{INSTALL_COMMAND}</code>
    <button type="button" class="key key--ribbon">{text.copy}</button>
    <span class="note" role="status"></span>
  </div>
</div>

<style>
  .strip {
    background: var(--strip);
    color: var(--on-strip);
  }

  .inner {
    max-width: 78rem;
    margin-inline: auto;
    padding: 1.1rem var(--gutter) 1.3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.5rem;
  }

  .inset {
    border-radius: 3px;
  }

  .inset .inner {
    padding: 1rem 1.1rem 1.15rem;
  }

  .command {
    flex: 1 1 28rem;
    min-width: 0;
    font-size: clamp(0.9rem, 0.75rem + 0.6vw, 1.1rem);
    line-height: 1.5;
    overflow-wrap: anywhere;
    /* Inside prose the inline-code chip style would otherwise cover the command. */
    padding: 0;
    background: none;
  }

  .command::before {
    content: '$ ';
    color: var(--on-strip-muted);
  }

  .command:focus-visible {
    outline-color: var(--on-strip);
  }

  .key {
    flex: none;
    font-size: 1.05rem;
    padding-inline: 1.1em;
  }

  .note {
    flex: 1 0 100%;
    min-height: 0;
    font-family: var(--font-legend);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--on-strip-muted);
  }

  .note:empty {
    display: none;
  }
</style>

<script>
  for (const strip of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const command = strip.querySelector<HTMLElement>('.command');
    const button = strip.querySelector<HTMLButtonElement>('button');
    const note = strip.querySelector<HTMLElement>('.note');
    if (!command || !button || !note) continue;

    const label = button.textContent ?? '';

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.textContent ?? '');
        button.textContent = strip.dataset.copied ?? label;
        setTimeout(() => {
          button.textContent = label;
        }, 2000);
      } catch {
        // Clipboard access can be refused; leave the command selected so one keypress copies it.
        const range = document.createRange();
        range.selectNodeContents(command);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        note.textContent = strip.dataset.manual ?? '';
      }
    });
  }
</script>
