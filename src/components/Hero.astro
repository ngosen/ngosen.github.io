---
import demoSteps from '../data/demo-steps.json';
import { DISTRIBUTIONS, LEVELS } from '../data/site';
import InstallStrip from './InstallStrip.astro';

// Without scripting the sheet shows the first phrase fully typed.
const first = demoSteps[0];
const firstKeys = first ? [...first.keys] : [];
const firstText = first?.steps.at(-1) ?? '';
const used = DISTRIBUTIONS.filter((item) => item.level === 'daily' || item.level === 'light');
---

<section class="hero" aria-labelledby="ten">
  <div class="inner">
    <div class="sheet">
      <h1 id="ten">Ngó Sen</h1>
      <p class="lede">
        Bộ gõ tiếng Việt cho Linux. Người giữ dự án chỉ vibecode nó: nêu việc cho trợ lý AI viết mã, rồi
        tự đo và gõ bằng nó mỗi ngày.
      </p>
      <p class="typed">
        <span data-demo-out>{firstText}</span><span class="caret" aria-hidden="true"></span>
      </p>
      <div class="try">
        <label for="go-thu">Gõ thử kiểu Telex</label>
        <input
          id="go-thu"
          type="text"
          inputmode="text"
          maxlength="80"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          placeholder="tieengs Vieejt"
          aria-describedby="go-thu-ghi-chu"
        />
      </div>
      <p class="status" id="go-thu-ghi-chu" data-demo-status>
        Chữ trên tờ giấy do bamboo-core ghép, cùng lõi mà Ngó Sen dùng, chạy ngay trong trình duyệt. Tắt
        bộ gõ đang bật thì mới thấy nó tự ghép. Phần khó hơn, thay chữ bên trong từng ứng dụng, thì trang
        web không thử được.
      </p>
    </div>

    <aside class="tested" aria-labelledby="may-da-thu">
      <h2 id="may-da-thu">Máy đã thử</h2>
      <ul>
        {
          used.map((item) => (
            <li>
              <span class="machine">{item.name}</span>
              <span class="stamp" data-level={item.level}>
                {LEVELS[item.level].label}
              </span>
              <span class="basis">{item.basis}</span>
            </li>
          ))
        }
      </ul>
      <p class="more">
        Tình trạng ngày 04/10/2026. <a href="#may-nao">Đủ mười bản Linux và nghĩa của từng dấu</a>
      </p>
    </aside>

    <div class="platen" aria-hidden="true"></div>

    <div class="board">
      <div class="keys" aria-hidden="true" data-demo-keys>
        {
          firstKeys.map((key) => (
            <span class:list={['key', { 'key--space': key === ' ' }]} data-state="done">
              {key === ' ' ? ' ' : key}
            </span>
          ))
        }
      </div>
      <button type="button" class="key toggle" data-demo-toggle hidden>Dừng</button>
    </div>
  </div>
  <InstallStrip />
</section>

<style>
  .hero {
    --stamp-ground: var(--enamel);
    background: var(--enamel);
    color: var(--on-enamel);
  }

  .inner {
    max-width: 78rem;
    margin-inline: auto;
    padding: 0 var(--gutter) clamp(1.5rem, 4vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'sheet'
      'platen'
      'board'
      'tested';
  }

  .sheet {
    grid-area: sheet;
    background: var(--paper);
    color: var(--ink);
    padding: clamp(1.5rem, 5vw, 3rem) clamp(1.25rem, 4vw, 3rem) clamp(2rem, 5vw, 3.25rem);
    border-radius: 2px 2px 0 0;
    box-shadow: 0 1.2rem 2rem -1.2rem rgb(0 0 0 / 0.55);
  }

  h1 {
    font-size: clamp(3.4rem, 2rem + 6.5vw, 6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    word-spacing: -0.28em;
  }

  .lede {
    margin-top: 1.1rem;
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .typed {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    min-height: 1.35em;
    font-family: var(--font-typed);
    font-size: clamp(1.7rem, 1.1rem + 2.6vw, 2.9rem);
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    /* Room for stacked marks (ễ, ậ) that reach past the line box. */
    padding-block: 0.12em;
  }

  .caret {
    display: inline-block;
    width: 0.5em;
    height: 0.1em;
    margin-left: 0.08em;
    background: var(--ribbon);
  }

  .try {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
    border-top: 1px solid var(--paper-edge);
    padding-top: 1.1rem;
  }

  label {
    font-family: var(--font-legend);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.35rem 0.1rem;
    border: 0;
    border-bottom: 2px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-typed);
    font-size: var(--step-1);
  }

  input::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }

  input:focus-visible {
    outline: none;
    border-bottom-color: var(--ribbon-text);
    box-shadow: 0 2px 0 var(--ribbon-text);
  }

  .status {
    margin-top: 0.9rem;
    max-width: 62ch;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .status[data-kind='error'] {
    color: var(--ink);
    font-weight: 600;
  }

  /* The roller the sheet feeds out of: it overlaps the sheet's bottom edge. */
  .platen {
    grid-area: platen;
    position: relative;
    height: 1.15rem;
    margin: -0.55rem calc(var(--gutter) * -0.35) 0;
    border-radius: 0.6rem;
    background: var(--enamel-deep);
    box-shadow:
      inset 0 0.2rem 0.2rem -0.1rem rgb(255 255 255 / 0.16),
      0 0.5rem 0.8rem -0.5rem rgb(0 0 0 / 0.6);
  }

  .board {
    grid-area: board;
    margin-top: clamp(1.1rem, 2.5vw, 1.75rem);
    min-height: 5.6rem;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    align-content: start;
    gap: 0.5rem 0.25rem;
  }

  /* On narrow screens the keys are placed straight on the board's grid, around the toggle. */
  .keys {
    display: contents;
  }

  .keys :global(.key) {
    min-width: 0;
    padding-inline: 0;
    font-size: 1.05rem;
    cursor: default;
    transition:
      transform 140ms var(--ease-out),
      box-shadow 140ms var(--ease-out),
      opacity 240ms var(--ease-out);
  }

  .keys :global(.key--space) {
    grid-column: span 2;
  }

  .keys :global(.key[data-state='done']) {
    opacity: 0.62;
  }

  .toggle {
    grid-row: 2;
    grid-column: 10 / -1;
    min-width: 0;
    min-height: 2.75rem;
    padding-inline: 0;
    font-size: 0.85rem;
  }

  .tested {
    grid-area: tested;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  h2 {
    font-family: var(--font-legend);
    font-weight: 600;
    font-size: var(--step-2);
    letter-spacing: 0.03em;
    line-height: 1.1;
    word-spacing: normal;
    text-transform: uppercase;
  }

  ul {
    list-style: none;
    padding: 0;
    margin-top: 1.2rem;
    display: grid;
    gap: 1.25rem;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.2rem 1rem;
  }

  .machine {
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .basis {
    grid-column: 1 / -1;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--on-enamel-muted);
  }

  .more {
    margin-top: 1.4rem;
    font-size: var(--step--1);
    color: var(--on-enamel-muted);
  }

  .more a {
    color: var(--on-enamel);
  }

  .tested a:focus-visible {
    outline-color: var(--on-enamel);
  }

  @media (min-width: 40rem) {
    .board {
      min-height: 0;
      display: flex;
      align-items: flex-start;
      gap: 0.8rem;
    }

    .toggle {
      flex: none;
      padding-inline: 0.75em;
      font-size: 0.95rem;
    }

    .keys {
      flex: 1;
      min-width: 0;
      min-height: 2.9rem;
      display: flex;
      gap: 0.35rem;
    }

    .keys :global(.key) {
      flex: 1 1 0;
      max-width: 5.25rem;
      font-size: 1.25rem;
      padding-block: 0.45em 0.4em;
    }

    .keys :global(.key--space) {
      flex-grow: 2.4;
      max-width: 11rem;
    }
  }

  @media (min-width: 62rem) {
    .inner {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      grid-template-areas:
        'sheet tested'
        'platen platen'
        'board board';
      column-gap: clamp(2rem, 4vw, 4rem);
    }

    .tested {
      margin-top: 0;
      padding-top: clamp(1.5rem, 3vw, 2.5rem);
      align-self: start;
    }

    .platen {
      margin-inline: -1rem;
    }
  }
</style>

<script>
  import demoSteps from '../data/demo-steps.json';

  interface GoRuntime {
    importObject: WebAssembly.Imports;
    run(instance: WebAssembly.Instance): Promise<void>;
  }

  declare global {
    interface Window {
      Go?: new () => GoRuntime;
      ngosenCompose?: (keys: string, final: boolean) => string;
    }
  }

  const KEY_MS = 220;
  const HOLD_MS = 2000;
  const SHOWN_KEYS = 16;

  const out = document.querySelector<HTMLElement>('[data-demo-out]');
  const row = document.querySelector<HTMLElement>('[data-demo-keys]');
  const status = document.querySelector<HTMLElement>('[data-demo-status]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-demo-toggle]');
  const field = document.querySelector<HTMLInputElement>('#go-thu');

  if (out && row && status && toggle && field) {
    const idleStatus = status.textContent ?? '';
    const line = out.parentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let timer: number | undefined;
    let playing = false;
    let visitorTyping = false;
    let core: 'none' | 'loading' | 'ready' | 'failed' = 'none';

    const drawKeys = (keys: string, state: string) => {
      row.replaceChildren(
        ...[...keys].map((key) => {
          const cap = document.createElement('span');
          cap.className = key === ' ' ? 'key key--space' : 'key';
          cap.dataset.state = state;
          cap.textContent = key === ' ' ? ' ' : key;
          return cap;
        }),
      );
    };

    const stop = () => {
      window.clearTimeout(timer);
      playing = false;
      toggle.textContent = 'Chạy lại';
    };

    const play = (phraseIndex: number, keyIndex: number) => {
      const phrase = demoSteps[phraseIndex];
      if (!phrase) {
        stop();
        return;
      }
      if (keyIndex === 0) {
        drawKeys(phrase.keys, 'todo');
        out.textContent = '';
        if (line) line.scrollLeft = 0;
      }
      const caps = row.children;
      const previous = caps[keyIndex - 1];
      if (previous instanceof HTMLElement) previous.dataset.state = 'done';
      if (keyIndex >= phrase.keys.length) {
        // The last phrase stays on the sheet; the run does not loop.
        if (phraseIndex + 1 >= demoSteps.length) {
          stop();
          return;
        }
        timer = window.setTimeout(() => play(phraseIndex + 1, 0), HOLD_MS);
        return;
      }
      const current = caps[keyIndex];
      if (current instanceof HTMLElement) current.dataset.state = 'now';
      out.textContent = phrase.steps[keyIndex] ?? '';
      timer = window.setTimeout(() => play(phraseIndex, keyIndex + 1), KEY_MS);
    };

    const start = () => {
      playing = true;
      visitorTyping = false;
      toggle.textContent = 'Dừng';
      play(0, 0);
    };

    const compose = (raw: string) => {
      const composeWord = window.ngosenCompose;
      if (core !== 'ready' || !composeWord) return raw;
      const tokens = raw.match(/[A-Za-z]+|[^A-Za-z]+/g) ?? [];
      return tokens
        .map((token, index) => {
          if (!/^[A-Za-z]/.test(token)) return token;
          return composeWord(token, index !== tokens.length - 1);
        })
        .join('');
    };

    const showVisitorText = () => {
      const raw = field.value;
      out.textContent = compose(raw);
      // The line never wraps; keep the end of it, where the caret is, in view.
      if (line) line.scrollLeft = line.scrollWidth;
      drawKeys(raw.slice(-SHOWN_KEYS), 'done');
      const last = row.lastElementChild;
      if (last instanceof HTMLElement) {
        last.dataset.state = 'now';
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          last.dataset.state = 'done';
        }, 180);
      }
    };

    const loadScript = (src: string) =>
      new Promise<void>((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error(`cannot load ${src}`));
        document.head.append(script);
      });

    const instantiate = async (imports: WebAssembly.Imports) => {
      try {
        return await WebAssembly.instantiateStreaming(fetch('/telex/telex.wasm'), imports);
      } catch {
        // Streaming compilation needs the application/wasm type; some hosts do not send it.
        const response = await fetch('/telex/telex.wasm');
        if (!response.ok) throw new Error(`telex.wasm: ${response.status}`);
        return WebAssembly.instantiate(await response.arrayBuffer(), imports);
      }
    };

    const loadCore = async () => {
      if (core !== 'none') return;
      core = 'loading';
      status.dataset.kind = 'loading';
      status.textContent = 'Đang tải lõi ghép chữ. Chữ sẽ tự ghép khi tải xong.';
      try {
        await loadScript('/telex/wasm_exec.js');
        if (!window.Go) throw new Error('wasm_exec.js did not define Go');
        const go = new window.Go();
        const { instance } = await instantiate(go.importObject);
        void go.run(instance);
        if (typeof window.ngosenCompose !== 'function') throw new Error('core did not start');
        core = 'ready';
        delete status.dataset.kind;
        status.textContent = idleStatus;
        if (visitorTyping) showVisitorText();
      } catch {
        core = 'failed';
        status.dataset.kind = 'error';
        status.textContent =
          'Không tải được lõi ghép chữ nên chữ chưa ghép dấu. Tải lại trang để thử lần nữa.';
      }
    };

    // A window that is not the active one gets no focus event, so the press itself also counts.
    for (const type of ['focus', 'pointerdown']) {
      field.addEventListener(type, () => {
        if (playing) stop();
        void loadCore();
      });
    }

    field.addEventListener('input', () => {
      if (playing) stop();
      if (!visitorTyping) {
        visitorTyping = true;
        out.setAttribute('aria-live', 'polite');
      }
      void loadCore();
      showVisitorText();
    });

    toggle.addEventListener('click', () => {
      if (playing) {
        stop();
        return;
      }
      field.value = '';
      out.removeAttribute('aria-live');
      start();
    });

    toggle.hidden = false;
    if (reducedMotion.matches) {
      toggle.textContent = 'Chạy lại';
    } else {
      start();
    }
  }
</script>
