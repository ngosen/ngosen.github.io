---
import { REPO } from '../data/site';

const english = Astro.url.pathname.startsWith('/en/');
---

<footer class="site-footer" lang="vi">
  <div class="inner">
    <p class="origin">
      Dựa trên mã của <a href="https://github.com/LotusInputMethod/fcitx5-lotus">fcitx5-lotus</a> và
      <a href="https://github.com/thanhpy2009/VMK">VMK</a>. Giấy phép GPL-3.0-or-later.
      Lõi gõ là <a href="https://github.com/bamboo-vi/bamboo-core">bamboo-core</a> bản Rust của
      <a href="https://github.com/nguyen10t2">@nguyen10t2</a> và
      <a href="https://github.com/BambooEngine/bamboo-core">bamboo-core</a> bản Go của
      <a href="https://github.com/t1ld3x">@t1ld3x</a>, cả hai đều dùng giấy phép MIT.
    </p>
    <ul>
      <li><a href={REPO}>Source code</a></li>
      <li><a href={`${REPO}/blob/main/CHANGELOG.md`}>Changelog</a></li>
      <li><a href="/ban-phat-hanh/">Các release</a></li>
      <li><a href="/roadmap/">Roadmap</a></li>
      <li><a href="/go-khong-gach-chan/">Cách người Việt gõ</a></li>
      <li><a href={`${REPO}/issues`}>Báo lỗi</a></li>
      <li>
        <a href={`${REPO}/discussions`} lang={english ? 'en' : 'vi'}>
          {english ? 'Discussions (in Vietnamese)' : 'Thảo luận'}
        </a>
      </li>
      <li><a href="/rss.xml">RSS của blog</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--strip);
    color: var(--on-strip);
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .inner {
    max-width: 78rem;
    margin-inline: auto;
    padding: 2.5rem var(--gutter) 3rem;
    display: grid;
    gap: 1rem;
  }

  p {
    max-width: var(--measure);
    color: var(--on-strip-muted);
  }

  .origin {
    color: var(--on-strip);
  }

  ul {
    list-style: none;
    padding: 0;
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    font-family: var(--font-legend);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  a:focus-visible {
    outline-color: var(--on-strip);
  }
</style>
