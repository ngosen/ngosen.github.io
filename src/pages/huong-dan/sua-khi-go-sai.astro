import Shot from '../../components/Shot.astro';

const toc = [
  { id: 'tu-khoi-phuc', label: 'Từ tiếng Anh trở lại như đã gõ' },
  { id: 'backspace', label: 'Backspace chỉ xoá dấu thanh' },
  { id: 'w-ra-u', label: 'Gõ w ra ư' },
  { id: 'ngoac-vuong', label: 'Phím [ ] ra ơ ư' },
