---
import Guide from '../../layouts/Guide.astro';
import Shot from '../../components/Shot.astro';

const toc = [
  { id: 'bat-mot-app', label: 'Bật gợi ý cho một app' },
  { id: 'chon-emoji', label: 'Chọn emoji gợi ý' },
  { id: 'khi-chon', label: 'Đặt emoji sau từ hay thay từ' },
  { id: 'doi-tu', label: 'Đổi từ gợi ý' },
  { id: 'xuat-nhap', label: 'Chia sẻ từ gợi ý' },
