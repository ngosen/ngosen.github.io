---
import Page from '../../layouts/Page.astro';
import { GUIDE } from '../../data/site';
---

<Page
  title="Hướng dẫn dùng Ngó Sen"
  description="Xem cách dùng Ngó Sen sau khi cài, từ bật tiếng Việt và chọn chế độ gõ đến tuỳ chỉnh và báo lỗi. Mỗi trang chỉ dẫn một việc, kèm ảnh cửa sổ thật."
  heading="Hướng dẫn"
>
  <p slot="lede">
    Mỗi trang hướng dẫn một việc, kèm ảnh chụp cửa sổ thật. Chưa cài Ngó Sen thì xem trang
    <a href="/cai-dat/">Cài đặt</a> trước. Các hướng dẫn này viết cho bản fcitx5;
    <a href="/ngo-sen-cho-gnome/">Ngó Sen cho GNOME</a> có cửa sổ cài đặt riêng.
  </p>

  {
    GUIDE.map((group) => (
      <section aria-labelledby={`nhom-${group.pages[0].href.split('/')[2]}`}>
        <h2 id={`nhom-${group.pages[0].href.split('/')[2]}`}>{group.title}</h2>
        <ol class="tasks">
          {group.pages.map((page) => (
            <li>
              <a href={page.href}>{page.label}</a>
              <p>{page.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Page>

<style>
  .tasks {
    list-style: none;
    padding-left: 0;
    border-top: 1px solid var(--paper-edge);
  }

  .tasks li {
    margin: 0;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--paper-edge);
  }

  .tasks a {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .tasks p {
    margin-top: 0.25rem;
    color: var(--ink-muted);
  }
</style>
