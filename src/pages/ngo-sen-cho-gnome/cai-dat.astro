import Shot from '../../components/Shot.astro';
import { GNOME_PAGES, IBUS_REPO } from '../../data/site';

const toc = [
  { id: 'goi', label: 'Chọn và cài gói' },
  { id: 'tren-gnome', label: 'Thêm nguồn nhập trên GNOME' },
  { id: 'desktop-khac', label: 'Cinnamon và Xfce' },
  { id: 'kho-goi', label: 'Cài từ repo gói' },
  { id: 'tu-fcitx5', label: 'Từ bản fcitx5 sang' },
  { id: 'sang-fcitx5', label: 'Chuyển sang bản fcitx5' },
