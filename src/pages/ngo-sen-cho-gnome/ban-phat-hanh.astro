---
import Page from '../../layouts/Page.astro';
import InlineCode from '../../components/InlineCode.astro';
import { GNOME_PAGES, IBUS_RELEASES, IBUS_REPO } from '../../data/site';

const changelog = `${IBUS_REPO}/blob/main/CHANGELOG.md`;
const download = (version: string) => `${IBUS_REPO}/releases/tag/ibus-ngosen-${version}`;
---

<Page
  title="Các version của Ngó Sen cho GNOME"
  description="Các version của Ngó Sen cho GNOME, bản chạy trên IBus: ngày phát hành, thay đổi chính, link tải gói và changelog đầy đủ."
  heading="Các version của Ngó Sen cho GNOME"
  toc={IBUS_RELEASES.map((release) => ({ id: `ban-${release.version}`, label: release.version }))}
  tocPages={GNOME_PAGES}
>
  <p slot="lede">
    Mỗi version ghi đoạn tóm tắt đầu mục của nó trong <a href={changelog}>changelog</a> của
    <code>ngosen/ibus-ngosen</code>. Changelog có đủ từng thay đổi.
  </p>

  {
    IBUS_RELEASES.map((release, index) => (
      <section class="release" aria-labelledby={`ban-${release.version}`}>
        <h2 id={`ban-${release.version}`}>
          {release.version}
          {index === 0 && <span class="latest">Mới nhất</span>}
        </h2>
        <p class="meta">
          <time datetime={release.date.split('/').reverse().join('-')}>{release.date}</time> ·{' '}
          <a href={download(release.version)}>Tải gói</a>
        </p>
        <p>
          <InlineCode text={release.summary} />
        </p>
      </section>
    ))
  }
</Page>

<style>
  .release + .release {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
  }

  .latest {
    font-family: var(--font-legend);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.06em;
    word-spacing: normal;
    text-transform: uppercase;
    padding: 0.1em 0.55em 0.05em;
    border: 1px solid currentColor;
    border-radius: 3px;
  }

  .meta {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
</style>
