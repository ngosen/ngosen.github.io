---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import InstallStrip from '../components/InstallStrip.astro';
import TelexBoard from '../components/TelexBoard.astro';
import { DISTRIBUTIONS, LEVELS, RELEASE, REPO, ROADMAP, type Level } from '../data/site';
import { formatDay, getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
const levels = Object.keys(LEVELS) as Level[];

// Every line is a user-visible change from CHANGELOG.md in the main repository; `pr` is its pull request.
const changes = [
  {
    claim: 'Không còn máy chủ nền.',
    source:
      'Bộ gõ xoá chữ cũ bằng phím gửi hộ qua fcitx5, hoặc qua XTEST trên X11. Không còn chương trình chạy ngầm có quyền đặc biệt, không cần quyền thiết bị.',
    pr: 43,
  },
  {
    claim: 'Chỉ còn hai chế độ gõ: Gõ Sen và Preedit, cùng chế độ Emoji.',
    source: 'Uinput đổi tên thành Gõ Sen; Surrounding Text gộp vào Gõ Sen. Cấu hình cũ tự chuyển sang tên mới.',
    pr: 43,
  },
  {
    claim: 'Lõi ghép dấu viết bằng Rust trong gói Fedora, Arch, openSUSE và Ubuntu 24.04 trở lên.',
    source: 'Debian 12, 13 và Ubuntu 22.04 vẫn dùng lõi Go. Hai lõi gõ ra chữ như nhau.',
    pr: 71,
  },
  {
    claim: 'Gõ nhanh trong Firefox trên GNOME không còn mất chữ.',
    source: 'Trước đó “viet” có lúc ra “v”. Ô soạn tin Facebook trên Edge cũng không còn ra “i” thay cho “đi”.',
    pr: 33,
  },
  {
    claim: 'Thanh địa chỉ Chrome, Edge và Chromium trên X11 không còn giữ dấu cũ.',
    source: 'Gõ lại một địa chỉ đã từng vào từng ra “tiêng” thay cho “tiếng”.',
    pr: 38,
  },
  {
    claim: 'VS Code bản Flatpak, và bản .deb chạy Wayland, gõ được tiếng Việt.',
    source: 'Bộ gõ không còn coi việc VS Code nhích con trỏ sau mỗi phím là một cú bấm chuột.',
    pr: 58,
  },
];

const notFixed = [
  'Game dùng SDL ngoài X11 không nhận phím gửi hộ, nên gõ ra chữ không dấu.',
  'VS Code bản snap phải gõ qua XIM, và khoảng một câu trong mười có một chữ sai dấu.',
  'Ubuntu 26.04 cần bật một extension của Ngó Sen cho tới khi GNOME tự sửa lỗi làm rơi phím xoá.',
  'Kiểu gõ được dùng và kiểm hằng ngày là Telex. VNI và các kiểu khác chưa kiểm kỹ.',
];
---

<Base
  title="Ngó Sen: bộ gõ tiếng Việt cho Linux"
  description="Bộ gõ tiếng Việt cho fcitx5 trên Linux. Cài bằng một dòng lệnh, ghi rõ đã thử trên máy nào, kèm roadmap tới bản 1.0."
  wordmark={false}
>
  <Hero />

  <section class="roadmap wrap" id="roadmap" aria-labelledby="roadmap-tieu-de">
    <div class="intro">
      <h2 id="roadmap-tieu-de">Roadmap: Ngó Sen 1.0</h2>
      <p>
        Bản 1.0 nhắm bốn thay đổi lớn. Chưa có ngày phát hành; đây là hướng đi, không phải lời hứa.
      </p>
    </div>
    <ul class="sheet goals">
      {
        ROADMAP.map((item) => (
          <li>
            <p class="goal">{item.goal}</p>
            <p class="detail">{item.detail}</p>
            <p class="progress" data-done={item.done ? '' : undefined}>
              <span class="progress-label">{item.done ? 'Xong' : 'Đang làm'}</span>
              {item.status}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="telex" aria-labelledby="telex-tieu-de">
    <div class="wrap">
      <div class="telex-head">
        <h2 id="telex-tieu-de">Nên dùng chế độ nào</h2>
        <p>
          Dùng <strong>Gõ Sen</strong> làm chế độ gõ chính: chọn trong cửa sổ cài đặt Ngó Sen, mục chế độ
          mặc định. Gõ Sen dùng cho mọi chỗ: gõ nhanh không mất chữ, gõ đúng trong trình duyệt, thanh địa
          chỉ, Facebook, app Electron như Zalo, và terminal. Chế độ này trước tên là Uinput; cấu hình cũ tự
          chuyển sang tên mới.
        </p>
        <p>
          <strong>Preedit</strong> hiện chữ gạch chân trong lúc gõ, dành cho app không hợp với Gõ Sen. Kiểu
          gõ được dùng và kiểm hằng ngày là Telex. VNI và các kiểu khác dùng được nhưng chưa kiểm kỹ.
        </p>
      </div>
      <h3 class="board-title">Telex nằm ở những phím này</h3>
      <p class="board-note">Phím mờ là phím chữ thường; phím đậm làm thêm một việc.</p>
      <TelexBoard />
      <dl class="telex-notes">
        <div>
          <dt>Dấu thanh</dt>
          <dd>
            Gõ sau nguyên âm: <kbd>s</kbd> sắc, <kbd>f</kbd> huyền, <kbd>r</kbd> hỏi, <kbd>x</kbd> ngã,
            <kbd>j</kbd> nặng. <kbd>as</kbd> ra á.
          </dd>
        </div>
        <div>
          <dt>Mũ, móc, trăng</dt>
          <dd>
            <kbd>aa</kbd> â, <kbd>ee</kbd> ê, <kbd>oo</kbd> ô, <kbd>aw</kbd> ă, <kbd>ow</kbd> ơ,
            <kbd>uw</kbd> ư, <kbd>dd</kbd> đ.
          </dd>
        </div>
        <div>
          <dt>Bỏ dấu</dt>
          <dd><kbd>z</kbd> bỏ dấu thanh vừa gõ: <kbd>asz</kbd> ra a.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="can-it-run wrap" id="may-nao" aria-labelledby="may-nao-tieu-de">
    <div class="intro">
      <h2 id="may-nao-tieu-de">Máy tôi có chạy được không?</h2>
      <p>
        Dòng lệnh cài chọn được gói cho các distro dưới đây, trên máy x86_64. Build được gói chưa có
        nghĩa là gõ được, nên mỗi distro mang một dấu ghi nó đã được thử tới đâu.
      </p>
      <dl class="legend">
        {
          levels.map((level) => (
            <div>
              <dt>
                <span class="stamp" data-level={level}>
                  {LEVELS[level].label}
                </span>
              </dt>
              <dd>{LEVELS[level].meaning}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="sheet tested-sheet">
      <table>
        <caption class="visually-hidden">Các distro và mức đã thử của từng distro</caption>
        <thead>
          <tr>
            <th scope="col">Distro</th>
            <th scope="col">Đã thử tới đâu</th>
            <th scope="col">Dựa trên</th>
          </tr>
        </thead>
        <tbody>
          {
            DISTRIBUTIONS.map((item) => (
              <tr>
                <th scope="row">{item.name}</th>
                <td class="level">
                  <span class="stamp" data-level={item.level}>
                    {LEVELS[item.level].label}
                  </span>
                </td>
                <td class="basis">{item.basis}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="sheet-note">
        Chép theo ghi chú của bản {RELEASE.version}, ngày {RELEASE.date}. Distro khác thì
        <a href="/cai-dat/#tu-build">tự build từ source</a>.
      </p>
    </div>
  </section>

  <section class="install" id="cai" aria-labelledby="cai-tieu-de">
    <div class="wrap install-head">
      <h2 id="cai-tieu-de">Cài bằng một dòng lệnh</h2>
      <p>
        Lệnh này tìm gói build sẵn cho đúng distro của máy trong bản release mới nhất, hỏi lại rồi mới
        tải, so hash SHA-256 của file tải về, rồi cài bằng trình quản lý gói của máy. Gói
        <code>fcitx5-lotus</code> nếu có sẽ bị thay; cấu hình cũ giữ nguyên.
        <a href="/cai-dat/">Cài bằng tay và các trường hợp khác</a>.
      </p>
    </div>
    <InstallStrip />
    <div class="wrap">
      <h3 class="after-title">Cài xong, còn ba việc</h3>
      <ol class="after">
        <li>
          <span class="key" aria-hidden="true">1</span>
          <div>
            <p>Khởi động lại fcitx5.</p>
            <pre tabindex="0"><code>fcitx5 -rd</code></pre>
          </div>
        </li>
        <li>
          <span class="key" aria-hidden="true">2</span>
          <div>
            <p>Mở “Fcitx5 Configuration” và thêm bộ gõ Ngó Sen.</p>
          </div>
        </li>
        <li>
          <span class="key" aria-hidden="true">3</span>
          <div>
            <p>
              Trên KDE Wayland: vào System Settings, mục Virtual Keyboard, chọn “Fcitx 5”.
            </p>
          </div>
        </li>
      </ol>
      <div class="install-notes">
        <p>
          <strong>Ubuntu 26.04:</strong> cài xong, đăng xuất rồi đăng nhập lại, sau đó chạy một lần
          <code>gnome-extensions enable forward-keys@ngosen.github.io</code>. Extension này sửa lỗi GNOME
          làm rơi phím xoá.
        </p>
        <p>
          <strong>Gỡ:</strong> bỏ Ngó Sen khỏi danh sách bộ gõ, gỡ gói <code>fcitx5-ngosen</code>, rồi chạy
          <code>fcitx5 -rd</code>. <a href="/cai-dat/#go">Lệnh gỡ cho từng distro</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="measured wrap" aria-labelledby="da-do-tieu-de">
    <div class="sheet report">
      <h2 id="da-do-tieu-de">Bản {RELEASE.version} đổi gì</h2>
      <ul>
        {
          changes.map((line) => (
            <li>
              <p class="claim">{line.claim}</p>
              <p class="source">
                {line.source} <a href={`${REPO}/pull/${line.pr}`}>#{line.pr}</a>
              </p>
            </li>
          ))
        }
      </ul>
      <p class="sheet-note">
        Đủ từng thay đổi trong <a href={`${REPO}/blob/main/CHANGELOG.md`}>changelog</a>. So với bản gốc:
        <a href="/khac-gi-ban-goc/">Khác gì bản gốc</a>.
      </p>
    </div>
    <div class="sheet open-items">
      <h3><span class="struck">Chưa sửa</span></h3>
      <ul>
        {notFixed.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </section>

  <section class="origin wrap" aria-labelledby="nguon-goc-tieu-de">
    <h2 id="nguon-goc-tieu-de">Nguồn gốc</h2>
    <div class="origin-text">
      <p>
        Người giữ dự án chỉ <strong>vibecode</strong> dự án này: nêu việc cho trợ lý AI viết mã, rồi đo và
        dùng thử hằng ngày. Kho để công khai cho ai cần thì lấy dùng, không hứa hỗ trợ.
      </p>
      <p>
        Ngó Sen tách ra từ <a href="https://github.com/LotusInputMethod/fcitx5-lotus">fcitx5-lotus</a>,
        vốn là bản fork của <a href="https://github.com/thanhpy2009/VMK">bộ gõ VMK</a>. Ngó sen là mầm mọc
        ra từ cây sen: cùng gốc với Lotus nhưng đi hướng riêng. Giấy phép vẫn là GPL-3.0-or-later.
      </p>
    </div>
  </section>

  <section class="notes wrap" aria-labelledby="ghi-chep-tieu-de">
    <h2 id="ghi-chep-tieu-de">Ghi chép</h2>
    <ul>
      {
        posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
              {formatDay(post.data.pubDate)}
            </time>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ul>
    <p class="all"><a href="/blog/">Tất cả bài viết</a></p>
  </section>
</Base>

<style>
  section {
    scroll-margin-top: 1rem;
  }

  h2 {
    font-size: var(--step-3);
  }

  .sheet-note {
    margin-top: 1.4rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* Which machines */
  .can-it-run {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 8vw, 6rem);
    display: grid;
    gap: 2.25rem;
  }

  .intro p {
    margin-top: 1rem;
    max-width: 46ch;
  }

  .legend {
    margin-top: 1.8rem;
    display: grid;
    gap: 1rem;
    --stamp-ground: var(--desk);
  }

  .legend dd {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 44ch;
  }

  .tested-sheet {
    padding: clamp(1.1rem, 3.5vw, 2.25rem) clamp(1.1rem, 3.5vw, 2.5rem) clamp(1.4rem, 3.5vw, 2.25rem);
  }

  .tested-sheet thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .tested-sheet tr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--paper-edge);
  }

  .tested-sheet th,
  .tested-sheet td {
    padding: 0;
    border: 0;
  }

  .tested-sheet tbody th {
    font-family: var(--font-typed);
    font-weight: 400;
    font-size: var(--step-1);
    letter-spacing: 0;
    text-transform: none;
  }

  .tested-sheet .basis {
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* Telex keyboard */
  .telex {
    background: var(--enamel);
    color: var(--on-enamel);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .telex-head {
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .telex-head p {
    margin-top: 1rem;
    max-width: 58ch;
    color: var(--on-enamel-muted);
  }

  .telex-notes {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: 1.5rem 3rem;
  }

  .telex-notes dt {
    font-family: var(--font-legend);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .telex-notes dd {
    margin-top: 0.3rem;
    max-width: 40ch;
    color: var(--on-enamel-muted);
  }

  .telex-notes kbd {
    padding: 0.05em 0.35em;
    border-radius: 0.25em;
    background: var(--cap);
    color: var(--cap-ink);
  }

  /* Measured results */
  .measured {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2rem, 5vw, 3.5rem);
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .report {
    padding: clamp(1.5rem, 4.5vw, 3.25rem);
  }

  .report ul,
  .open-items ul {
    list-style: none;
    padding: 0;
  }

  .report ul {
    margin-top: 1.9rem;
    display: grid;
    gap: 1.6rem;
  }

  .claim {
    font-family: var(--font-typed);
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 52ch;
    text-wrap: pretty;
  }

  .source {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .open-items {
    padding: clamp(1.25rem, 3.5vw, 2rem);
  }

  .open-items h3 {
    font-family: var(--font-legend);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: 0.06em;
    word-spacing: normal;
    text-transform: uppercase;
  }

  .struck {
    display: inline-block;
    padding: 0.1em 0.6em 0.05em;
    border: 2px solid currentColor;
    border-radius: 3px;
    color: var(--ribbon-text);
    transform: rotate(-2deg);
  }

  .open-items ul {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.9rem;
    font-family: var(--font-typed);
    line-height: 1.5;
  }

  /* Install */
  .install {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .install-head {
    padding-bottom: 1.8rem;
  }

  .install-head p {
    margin-top: 1rem;
    max-width: var(--measure);
  }

  .install-head code {
    padding: 0.08em 0.3em;
    background: var(--paper);
    border-radius: 2px;
  }

  .after-title {
    margin-top: clamp(2rem, 5vw, 3rem);
    font-size: var(--step-2);
  }

  .after {
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  .after li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .after .key {
    cursor: default;
    font-size: 1.15rem;
  }

  .after pre {
    margin-top: 0.6rem;
  }

  /* Blog */
  .notes {
    padding-top: clamp(3.5rem, 9vw, 7rem);
  }

  .notes ul {
    list-style: none;
    padding: 0;
    margin-top: 1.6rem;
    border-top: 1px solid var(--ink);
  }

  .notes li {
    padding-block: 1.3rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    display: grid;
    gap: 0.3rem 2rem;
  }

  .notes time {
    font-family: var(--font-legend);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .notes li a {
    font-family: var(--font-typed);
    font-size: var(--step-2);
    line-height: 1.25;
    text-decoration-thickness: 1px;
  }

  .notes li p {
    max-width: 62ch;
    color: var(--ink-muted);
  }

  .all {
    margin-top: 1.4rem;
    font-family: var(--font-legend);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (min-width: 44rem) {
    .telex-notes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .after {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .notes li {
      grid-template-columns: 7rem minmax(0, 1fr);
    }

    .notes li p {
      grid-column: 2;
    }
  }

  @media (min-width: 62rem) {
    .can-it-run {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }

    .intro {
      position: sticky;
      top: 2rem;
    }

    .measured {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: 0;
    }

    /* The second sheet lies on top of the first, slightly turned, as a note left on a report. */
    .open-items {
      margin: 5.5rem 0 0 -2.5rem;
      transform: rotate(1.2deg);
    }
  }

  /* Roadmap */
  .roadmap {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 8vw, 6rem);
    display: grid;
    gap: 2.25rem;
  }

  .goals {
    list-style: none;
    margin: 0;
    padding: clamp(1.1rem, 3.5vw, 2.25rem) clamp(1.1rem, 3.5vw, 2.5rem);
  }

  .goals li {
    padding-block: 1.2rem;
    border-bottom: 1px solid var(--paper-edge);
  }

  .goals li:first-child {
    padding-top: 0;
  }

  .goals li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .goal {
    font-family: var(--font-typed);
    font-size: var(--step-1);
    line-height: 1.3;
    text-wrap: balance;
  }

  .detail {
    margin-top: 0.4rem;
    max-width: 62ch;
  }

  .progress {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .progress-label {
    margin-right: 0.5em;
    font-family: var(--font-legend);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .progress[data-done] .progress-label {
    font-weight: 700;
  }

  /* Modes and the Telex board */
