---
import { render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import Page from '../../layouts/Page.astro';
import { REPO } from '../../data/site';
import { formatDay, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const jsonLd = {
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString().slice(0, 10),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10),
  inLanguage: 'vi',
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL('/og.png', Astro.site).href,
};
---

<Page
  title={`${post.data.title} | Ngó Sen`}
  description={post.data.description}
  heading={post.data.title}
  type="article"
  published={post.data.pubDate}
  modified={post.data.updatedDate}
  jsonLd={jsonLd}
>
  <p slot="lede">
    <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDay(post.data.pubDate)}</time>
  </p>
  {
    post.data.outdated && (
      <aside class="outdated" aria-label="Ghi chú cập nhật">
        <p>
          <strong>Ghi chú sau này.</strong> {post.data.outdated} Xem
          <a href={`${REPO}/blob/main/CHANGELOG.md`}>changelog</a>.
        </p>
      </aside>
    )
  }
  <Content />
  <Comments />
  <p class="back"><a href="/blog/">Tất cả bài viết</a></p>
</Page>

<style>
  time {
    font-family: var(--font-legend);
    font-weight: 500;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
  }

  .outdated {
    margin-bottom: 2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--paper-edge);
    border-radius: 3px;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .back {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--paper-edge);
    font-family: var(--font-legend);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>
