---
import { render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { formatDay, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Page title={`${post.data.title} | Ngó Sen`} description={post.data.description} heading={post.data.title}>
  <p slot="lede">
    <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDay(post.data.pubDate)}</time>
  </p>
  <Content />
  <p class="back"><a href="/blog/">Tất cả bài viết</a></p>
</Page>

<style>
  time {
    font-family: var(--font-legend);
    font-weight: 500;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
  }

  .back {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--paper-edge);
    font-family: var(--font-legend);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>
