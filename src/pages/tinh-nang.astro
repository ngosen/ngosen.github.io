import { REPO } from '../data/site';

const toc = [
  { id: 'go-nhanh-hon', label: 'Gõ nhanh hơn, đúng chính tả hơn' },
  { id: 'lenh-terminal-vim', label: 'Lệnh, terminal và Vim' },
  { id: 'cuu-chu-cuu-dau-chuyen-ma', label: 'Cứu chữ, Cứu dấu, Chuyển mã' },
  { id: 'che-do-go-va-phim-chuyen', label: 'Chế độ gõ và phím chuyển Anh/Việt' },
  { id: 'emoji-va-go-tat', label: 'Emoji và gõ tắt' },
  { id: 'cua-so-cai-dat-va-kiem-tra', label: 'Cửa sổ cài đặt, khay và Kiểm tra máy' },
