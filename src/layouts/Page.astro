---
import Base from './Base.astro';
import OnThisPage, { type TocItem, type TocPage } from '../components/OnThisPage.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  lang?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  jsonLd?: Record<string, unknown>;
  toc?: TocItem[];
  tocPages?: TocPage[];
}

const { title, description, heading, lang, type, published, modified, jsonLd, toc, tocPages } = Astro.props;
---

<Base
  title={title}
  description={description}
  lang={lang}
  type={type}
  published={published}
  modified={modified}
  jsonLd={jsonLd}
>
  <article class:list={['wrap', { 'with-toc': toc }]}>
    {toc && <OnThisPage items={toc} pages={tocPages} lang={lang} />}
    <div class="sheet page">
      <header>
        <h1>{heading}</h1>
        <slot name="lede" />
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  article {
    padding-top: clamp(1.25rem, 4vw, 3rem);
  }

  /* With an index: the slip sits above the sheet, then beside it once both fit. */
  .with-toc {
    display: grid;
    /* minmax(0, …) keeps a wide table from stretching the column past a phone screen. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .with-toc .page :global(h2),
  .with-toc .page :global(h3) {
    scroll-margin-top: 1.5rem;
  }

  @media (min-width: 76rem) {
    .with-toc {
      grid-template-columns: 15rem minmax(0, 60rem);
      gap: 2.5rem;
      align-items: start;
    }
  }

  .page {
    max-width: 60rem;
    padding: clamp(1.5rem, 6vw, 4.5rem) clamp(1.1rem, 6vw, 5rem) clamp(2.5rem, 7vw, 5rem);
  }

  header {
    max-width: var(--measure);
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--ink);
  }

  h1 {
    font-size: clamp(2.1rem, 1.4rem + 3.2vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  header :global(p) {
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
  }
</style>
