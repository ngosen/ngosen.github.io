---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  lang?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  jsonLd?: Record<string, unknown>;
}

const { title, description, heading, lang, type, published, modified, jsonLd } = Astro.props;
---

<Base
  title={title}
  description={description}
  lang={lang}
  type={type}
  published={published}
  modified={modified}
  jsonLd={jsonLd}
>
  <article class="wrap">
    <div class="sheet page">
      <header>
        <h1>{heading}</h1>
        <slot name="lede" />
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  article {
    padding-top: clamp(1.25rem, 4vw, 3rem);
  }

  .page {
    max-width: 60rem;
    padding: clamp(1.5rem, 6vw, 4.5rem) clamp(1.1rem, 6vw, 5rem) clamp(2.5rem, 7vw, 5rem);
  }

  header {
    max-width: var(--measure);
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--ink);
  }

  h1 {
    font-size: clamp(2.1rem, 1.4rem + 3.2vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  header :global(p) {
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
  }
</style>
